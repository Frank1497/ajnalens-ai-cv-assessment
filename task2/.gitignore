# Dataset: 3.4 GB of Roboflow images + provenance notes. Re-download with
# `python task2/src/hardhat_pipeline.py download`. Source/licence recorded
# in root data/README.md instead.
data/

# Pretrained/intermediate weights (warm-start init, person detector, OCR
# intermediates) -- inputs to the pipeline, not a deliverable. Re-download
# or regenerate via task2/src/hardhat_pipeline.py.
weights/

# Videos exceed GitHub's 100 MB file limit. Regenerate with task2/src/zone_monitor.py.
outputs/**/*.mp4
outputs/**/*.avi

# Training scratch
outputs/.scratch/

# Per-experiment training runs (checkpoints, batch previews) -- not a
# deliverable; the final model lives in outputs/4_export/.
outputs/runs/

*.cache
*.npy
__pycache__/

# Root .gitignore drops *.pt and *.onnx. The FINAL exported model is a
# Task 2 deliverable (about 32 MB), keep it.
!outputs/4_export/best.onnx
!outputs/4_export/best_fp16.onnx
!outputs/4_export/best.engine
